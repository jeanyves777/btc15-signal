SYMBOL=BTCUSDT
SPOT_BASE_URL=https://data-api.binance.vision
FUTURES_BASE_URL=https://fapi.binance.com
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES=KXBTC15M
POLL_SECONDS=10
ENTRY_SECONDS_REMAINING=300
ENTRY_TOLERANCE_SECONDS=20
MIN_CALIBRATION_SAMPLES=100
MIN_WIN_PROBABILITY=0.80
MIN_RAW_PROBABILITY=0.50
VALIDATED_LOWER_PROBABILITY=0.8290
MIN_CONTRACT_EDGE=0.03
ENTRY_ALERTS_ENABLED=true
STRATEGY_PATH=strategy.json
REVERSION_STRATEGY_PATH=reversion_strategy.json
MAX_SPREAD_BPS=2.0
DATABASE_PATH=btc15.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=0
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
EXECUTION_ENABLED=false
TRADE_CONTRACT_COUNT=1
DRY_RUN=true

# Settlement reference recorder (shadow only; FINDINGS 41).
# Without a CF Benchmarks entitlement the recorder still captures the official
# 60-second BRTI averages from Kalshi and writes an explicit gap row for BRTI.
# It never substitutes another exchange for the reference.
REFERENCE_ENABLED=true
CFB_API_KEY=
