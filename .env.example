SYMBOL=BTCUSDT
SPOT_BASE_URL=https://data-api.binance.vision
FUTURES_BASE_URL=https://fapi.binance.com
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES=KXBTC15M
POLL_SECONDS=10
ENTRY_SECONDS_REMAINING=300
ENTRY_TOLERANCE_SECONDS=20
MIN_CALIBRATION_SAMPLES=100
MIN_WIN_PROBABILITY=0.80
MIN_RAW_PROBABILITY=0.50
VALIDATED_LOWER_PROBABILITY=0.8290
MIN_CONTRACT_EDGE=0.03
ENTRY_ALERTS_ENABLED=true
STRATEGY_PATH=strategy.json
REVERSION_STRATEGY_PATH=reversion_strategy.json
MAX_SPREAD_BPS=2.0
DATABASE_PATH=btc15.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=0
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
EXECUTION_ENABLED=false
TRADE_CONTRACT_COUNT=1
DRY_RUN=true

# Settlement reference recorder (shadow only; FINDINGS 41).
# Without a CF Benchmarks entitlement the recorder still captures the official
# 60-second BRTI averages from Kalshi and writes an explicit gap row for BRTI.
# It never substitutes another exchange for the reference.
REFERENCE_ENABLED=true
CFB_API_KEY=

# --- copy trading to other Kalshi accounts ----------------------------------
# Forwards every order - entry, upsize, exit - to up to two other accounts, each
# with its own API key and its OWN SIZING. Write-only: no balance, fill,
# settlement or P&L is ever read from a mirror, so nothing here can reach the
# ledger or the money reporting.
#
# Requires MIRROR_ENABLED=true AND a key pair AND execution live. DRY_RUN never
# mirrors. A block missing either the key id or the key path is ignored.
#
# Sizing per account, base through upsize, in the primary's own units:
#   BASE_BUDGET     dollars PER CONTRACT (like AUTO_BUDGET). 0 = ignore the
#                   budget and buy BASE_CONTRACTS outright. The budget can only
#                   make an order smaller than the tier, never larger.
#   BASE_CONTRACTS  the tier - how many contracts a base entry buys here
#   ADD_CONTRACTS   the upsize. 0 = use whatever count the primary's add used
#   MAX_CONTRACTS   hard ceiling on every order on this account. 0 = none
# A mirror does NOT inherit the primary's tier, so the growth controller raising
# the primary's size leaves a smaller mirror account alone.
MIRROR_ENABLED=false
MIRROR_1_API_KEY_ID=
MIRROR_1_PRIVATE_KEY_PATH=
MIRROR_1_BASE_BUDGET=0
MIRROR_1_BASE_CONTRACTS=1
MIRROR_1_ADD_CONTRACTS=0
MIRROR_1_MAX_CONTRACTS=0
MIRROR_2_API_KEY_ID=
MIRROR_2_PRIVATE_KEY_PATH=
MIRROR_2_BASE_BUDGET=0
MIRROR_2_BASE_CONTRACTS=1
MIRROR_2_ADD_CONTRACTS=0
MIRROR_2_MAX_CONTRACTS=0

# BTC daily target: each account's opening capital, net of fees; midnight ET reset.
# Exits and shadow recording continue. Enable explicitly for live execution.
DAILY_PROFIT_TARGET_ENABLED=false
DAILY_PROFIT_TARGET_RATE=0.03
DAILY_PROFIT_STOP_RATE=0.03
MIRROR_DAILY_PROFIT_TARGET_RATE=0.03
MIRROR_TARGET_MAX_WINS=0
ALLSIGNAL_AFTER_TARGET_STAKE=0
MIRROR_1_ALLSIGNAL_AFTER_TARGET_STAKE=0
MIRROR_2_ALLSIGNAL_AFTER_TARGET_STAKE=0
MIRROR_3_ALLSIGNAL_AFTER_TARGET_STAKE=0
MIRROR_AFTER_PRIMARY_DONE=true

# Skip BTC signals while a chop range is locked (reports/oct6_regime_deep).
ALLSIGNAL_OHLC_LOCK_SKIP=false
